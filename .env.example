VITE_FIREBASE_API_KEY=your_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=swiftopsbd.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=swiftopsbd
VITE_FIREBASE_STORAGE_BUCKET=swiftopsbd.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# React calls /api through the Vite proxy locally. Set this only when the API
# is deployed to a different origin, for example https://api.example.com.
VITE_API_BASE_URL=
